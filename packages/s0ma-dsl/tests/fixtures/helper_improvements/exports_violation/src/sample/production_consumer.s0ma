module production_consumer
    layer: APPLICATION
    version: 1.0.0
    intent: "Production module that imports a re-exported helper. exports_helpers does NOT widen access-control; the import must still trigger HELPER_PRIVATE_TO_MODULE."
    uses: [shared_utils._compare]
    exports: [identity_check]

    requires: none
    soft_requires: none
    runtime_only_requires: none
    deferred_requires: none
    exports_helpers: none
nerve identity_check :: APPLICATION
    kind: FUNCTION
    visibility: PUBLIC
    intent: "Check whether two values are equal — uses the re-exported _compare helper."
    expects: "Two values."
    guarantees: "Returns True iff they are equal."
    forbids: none
    evaluates_at: FUNCTION_BOUNDARY
    provides: none
    returns: none
    raises: none
    interface: none
    latency_ms: none
    depends_on: none
    internal: none
    expected_exceptions: none
    consumes_via_dict: none
    declares_attributes: none
    covered_by: none
    ---
    def identity_check(a, b):
        return _compare(a, b)

module orphan
    layer: PRESENTATION
    version: 1.0.0
    intent: "Orphan module that declares landmark:header but is not marked as a page composer; exists to trigger NO_PAGE_COMPOSER_DECLARED."
    exports: [render_orphan]

    requires: none
    uses: none
    soft_requires: none
    runtime_only_requires: none
    deferred_requires: none
    exports_helpers: none
nerve render_orphan :: PRESENTATION
    kind: FUNCTION
    visibility: PUBLIC
    intent: "Render the orphan header — no page composer wraps it."
    expects: "No arguments."
    guarantees: "Returns a string with a header."
    forbids: none
    evaluates_at: FUNCTION_BOUNDARY
    declares_attributes: [landmark:header]
    provides: none
    returns: none
    raises: none
    interface: none
    latency_ms: none
    depends_on: none
    internal: none
    expected_exceptions: none
    consumes_via_dict: none
    covered_by: none
    ---
    def render_orphan() -> str:
        return "<header>orphan</header>"

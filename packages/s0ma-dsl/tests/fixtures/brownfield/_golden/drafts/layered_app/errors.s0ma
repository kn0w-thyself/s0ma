cell BookNotFoundError :: DOMAIN
    kind: EXCEPTION
    visibility: PUBLIC
    intent: "FIXME(adopt): say in one sentence why this exists and who reads it."
    schema: "FIXME(adopt): say what this holds and what shape it has, in plain words."
    invariants: none
    covered_by: none
    ---
    class BookNotFoundError(CatalogError):
        """No title in the catalogue carries the requested ISBN."""

        def __init__(self, isbn: str) -> None:
            super().__init__(f"no title with ISBN {isbn} is in the catalogue")
            self.isbn = isbn

cell DuplicateBookError :: DOMAIN
    kind: EXCEPTION
    visibility: PUBLIC
    intent: "FIXME(adopt): say in one sentence why this exists and who reads it."
    schema: "FIXME(adopt): say what this holds and what shape it has, in plain words."
    invariants: none
    covered_by: none
    ---
    class DuplicateBookError(CatalogError):
        """A title with this ISBN is already in the catalogue."""

        def __init__(self, isbn: str) -> None:
            super().__init__(f"ISBN {isbn} is already in the catalogue")
            self.isbn = isbn

cell StorageCorruptError :: DOMAIN
    kind: EXCEPTION
    visibility: PUBLIC
    intent: "FIXME(adopt): say in one sentence why this exists and who reads it."
    schema: "FIXME(adopt): say what this holds and what shape it has, in plain words."
    invariants: none
    covered_by: none
    ---
    class StorageCorruptError(BookshelfError):
        """A stored table could not be read back as a list of records."""

        def __init__(self, table: str, reason: str) -> None:
            super().__init__(f"the {table} table could not be read: {reason}")
            self.table = table
            self.reason = reason


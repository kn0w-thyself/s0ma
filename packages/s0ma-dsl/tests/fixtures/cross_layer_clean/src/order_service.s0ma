module order_service
    layer: APPLICATION
    version: 1.0.0
    intent: "Application-layer service that orchestrates order processing using the Order domain model."
    uses: [order_model.Order]
    exports: [process_order]

    requires: none
    soft_requires: none
    runtime_only_requires: none
    deferred_requires: none
    exports_helpers: none
nerve process_order :: APPLICATION
    kind: SERVICE
    visibility: PUBLIC
    intent: "Validates an Order and returns one of 'queued' or 'rejected'."
    expects: "An Order instance with a non-empty id."
    guarantees: "Returns one of 'queued' or 'rejected'."
    forbids: none
    evaluates_at: FUNCTION_BOUNDARY
    provides: none
    returns: none
    raises: none
    interface: none
    latency_ms: none
    depends_on: none
    internal: none
    expected_exceptions: none
    consumes_via_dict: none
    declares_attributes: none
    covered_by: none
    ---
    def process_order(order: Order) -> str:
        if not order.id:
            return "rejected"
        return "queued"

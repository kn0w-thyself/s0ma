module secondary_nav
    layer: PRESENTATION
    version: 1.0.0
    intent: "Renders a duplicate secondary <nav> landmark — no budget configured so this is allowed."
    exports: [render_secondary_nav]

    requires: none
    uses: none
    soft_requires: none
    runtime_only_requires: none
    deferred_requires: none
    exports_helpers: none
nerve render_secondary_nav :: PRESENTATION
    kind: FUNCTION
    visibility: PUBLIC
    intent: "Renders the secondary navigation landmark — exists alongside the primary one without violation."
    expects: "No arguments."
    guarantees: "Returns a string starting with '<nav'."
    forbids: none
    evaluates_at: FUNCTION_BOUNDARY
    declares_attributes: [landmark:nav]
    provides: none
    returns: none
    raises: none
    interface: none
    latency_ms: none
    depends_on: none
    internal: none
    expected_exceptions: none
    consumes_via_dict: none
    covered_by: none
    ---
    def render_secondary_nav() -> str:
        return "<nav>Secondary</nav>"

nerve survival_card_resource :: PRESENTATION
    kind: FUNCTION
    visibility: PUBLIC
    intent: "Serves the survival card (under 4 KB): the bootstrap loop, the three body rules, one minimal valid module, and the recovery moves for the top diagnostic codes — deliberately small enough to hold in context"
    expects: "the survival card is packaged under s0ma_mcp/_docs"
    guarantees: "Returns the full survival-card text (deliberately under a few KB)"
    forbids: none
    evaluates_at: FUNCTION_BOUNDARY
    metadata:
        mcp_uri: "s0ma://guide/survival-card"
    depends_on:
        load_doc: {relation: CALLS, carries: "loader key", coupling: TIGHT}
    provides: none
    returns: none
    raises: none
    interface: none
    latency_ms: none
    internal: none
    expected_exceptions: none
    consumes_via_dict: none
    declares_attributes: none
    covered_by: none
    ---
    def survival_card_resource() -> str:
        """The s0ma survival card (under 4 KB) — read this FIRST, hold it in context.

        The 60-second version of everything needed to author valid
        modules: the bootstrap loop (project_status -> init_project ->
        scaffold_module -> edit -> check -> build_project), the three
        rules that prevent most errors (only edit .s0ma; a nerve body is
        exactly one def; imports are declared in the module header's
        requires:, never written in bodies), one minimal valid module,
        and the fix for the most common diagnostic codes. Small by
        contract — safe to read whole even in a tight context window.
        """
        return load_doc("survival-card")


module music
    layer: DOMAIN
    version: 0.1.0
    intent: "This file holds what the app knows about music: a song and the mood it settles on."
    requires: [dataclasses:dataclass]
    exports: [Track, Mood, settle_mood]

    uses: none
    soft_requires: none
    runtime_only_requires: none
    deferred_requires: none
    exports_helpers: none
cell Track :: DOMAIN
    kind: MODEL
    visibility: PUBLIC
    intent: "A song that is playing: its title, who made it, how fast and how loud it is, and whether it is in a major key."
    schema: "title: str, artist: str, beats_per_minute: int, loudness: float, major_key: bool"
    invariants: "Loudness runs from 0, silent, to 1, as loud as the song gets."
    covered_by: none
    ---
    @dataclass(frozen=True)
    class Track:
        title: str
        artist: str
        beats_per_minute: int
        loudness: float
        major_key: bool

cell Mood :: DOMAIN
    kind: MODEL
    visibility: PUBLIC
    intent: "The mood a song puts across, as one word and a short plain description."
    schema: "name: str, description: str"
    invariants: "The name is one of lively, tense, calm, or low."
    covered_by: none
    ---
    @dataclass(frozen=True)
    class Mood:
        name: str
        description: str

nerve settle_mood :: DOMAIN
    kind: FUNCTION
    visibility: PUBLIC
    intent: "Decides which mood a song puts across, from how fast and loud it is and its key."
    expects: "A song."
    guarantees: "Gives back exactly one of four moods: lively, tense, calm, or low."
    forbids: "Never picks a mood outside those four."
    evaluates_at: FUNCTION_BOUNDARY
    provides: none
    returns: none
    raises: none
    interface: none
    latency_ms: none
    depends_on: none
    internal: none
    expected_exceptions: none
    consumes_via_dict: none
    declares_attributes: none
    covered_by: none
    ---
    def settle_mood(track: Track) -> Mood:
        """Settle on one of four moods from *track*."""
        energetic = track.beats_per_minute >= 100 and track.loudness >= 0.5
        bright = track.major_key
        if energetic and bright:
            return Mood(name="lively", description="full of energy and bright")
        if energetic:
            return Mood(name="tense", description="full of energy and dark")
        if bright:
            return Mood(name="calm", description="quiet and bright")
        return Mood(name="low", description="quiet and dark")

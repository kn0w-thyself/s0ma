module island_b
    layer: PRESENTATION
    version: 1.0.0
    intent: "Island B — declares landmark:main but does not use: any other module."
    exports: [render_island_b]

    requires: none
    uses: none
    soft_requires: none
    runtime_only_requires: none
    deferred_requires: none
    exports_helpers: none
nerve render_island_b :: PRESENTATION
    kind: FUNCTION
    visibility: PUBLIC
    intent: "Render island B's main landmark in isolation."
    expects: "No arguments."
    guarantees: "Returns a string with a main."
    forbids: none
    evaluates_at: FUNCTION_BOUNDARY
    declares_attributes: [landmark:main]
    provides: none
    returns: none
    raises: none
    interface: none
    latency_ms: none
    depends_on: none
    internal: none
    expected_exceptions: none
    consumes_via_dict: none
    covered_by: none
    ---
    def render_island_b() -> str:
        return "<main>B</main>"

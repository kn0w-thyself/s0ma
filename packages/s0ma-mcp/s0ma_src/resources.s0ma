module resources
    layer: PRESENTATION
    version: 0.7.0
    intent: "Agent-guide and meta resource providers for the s0ma authoring MCP server: the packaged alignment corpus and runtime self-prompting guide, the generated error catalog and changelog, the live version surface, the server's own self-model, the per-project operational runbook, and the packaged documentation snapshot every read surface of this server answers from, with the three bounded s0ma://docs resources that make it addressable."
    requires: [functools, json, platform, pathlib.Path, dataclasses.dataclass, importlib:metadata, importlib:resources, typing.Any, s0ma_mcp:self_model_json]
    deferred_requires: [s0ma_dsl.project:S0maProject, s0ma_dsl.errors:S0maProjectNotFound, s0ma_dsl.cli.main:_discover_s0ma_files, s0ma_dsl.cache:extract_module_name, s0ma_dsl.docs_model:deserialize_bundle, s0ma_dsl.docs_model.resolve:TopicIndex, s0ma_dsl.docs_model.learn_pages:page_path, s0ma_dsl.docs_model.reference_pages:PAGE_BY_ID_CLASS, s0ma_dsl.docs_model.reference_pages:deep_link]
    exports: [GuideDoc, GUIDE_DOCS, load_doc, getting_started_resource, survival_card_resource, self_prompting_resource, system_prompt_resource, quick_reference_resource, quick_reference_machine_resource, patterns_resource, spec_resource, errors_resource, changelog_resource, version_document, version_resource, self_model_resource, runbook_resource, DOCS_MODEL_FILENAME, DOCS_MODEL_SOURCE, DOCS_ROOT, DOCS_MAP_PAGE, DOCS_SURFACES_PAGE, DOCS_CATEGORY_WORDS, load_docs_model, docs_bundle, docs_topic_index, docs_snapshot_identity, docs_page_for, docs_journey_steps, docs_journey_recovery, docs_index_resource, docs_concepts_resource, docs_journeys_resource]

    uses: none
    soft_requires: none
    runtime_only_requires: none
    exports_helpers: none
cell SERVER_NAME :: PRESENTATION
    kind: CONSTANT
    visibility: INTERNAL
    intent: "The MCP server name (FR-MCP-1) in the version document."
    schema: "str constant. Value: s0ma-authoring."
    invariants: none
    covered_by: none
    ---
    SERVER_NAME: str = "s0ma-authoring"

cell GuideDoc :: PRESENTATION
    kind: MODEL
    visibility: PUBLIC
    intent: "One packaged document (agent guide or meta resource): its loader key, MCP resource URI, packaged filename, and drift-gate source path."
    schema: "Frozen dataclass. key: str, uri: str, filename: str, source: str. All fields required; source is repo-root-relative and used only by the drift gate."
    invariants: none
    covered_by: none
    ---
    @dataclass(frozen=True)
    class GuideDoc:
        """One packaged document (agent guide or meta resource).

        Attributes:
            key: Short identifier used by :func:`load_doc`.
            uri: The MCP resource URI the server registers for it.
            filename: Filename inside ``s0ma_mcp/_docs/``.
            source: Repo-root-relative path of the in-repo source document
                this file is a committed copy of (the drift gate compares
                the two; most live under ``packages/s0ma-dsl/docs/``, the
                changelog at the repo root, and the quick reference in both
                its forms under ``docs/``, where the documentation build
                writes it).
        """

        key: str
        uri: str
        filename: str
        source: str

cell GUIDE_DOCS :: PRESENTATION
    kind: CONSTANT
    visibility: PUBLIC
    intent: "Keyed registry of every packaged document the server serves: key, URI, packaged filename, and the in-repo source the drift gate byte-compares."
    schema: "dict[str, GuideDoc] keyed by loader key; source paths are monorepo-root-relative and exist only in a repo checkout."
    invariants: none
    covered_by: none
    ---
    GUIDE_DOCS: dict[str, GuideDoc] = {
        doc.key: doc
        for doc in (
            GuideDoc(
                key="getting-started",
                uri="s0ma://guide/getting-started",
                filename="getting-started.md",
                source="docs/getting-started.md",
            ),
            GuideDoc(
                key="survival-card",
                uri="s0ma://guide/survival-card",
                filename="survival_card.md",
                source="packages/s0ma-dsl/docs/survival_card.md",
            ),
            GuideDoc(
                key="system-prompt",
                uri="s0ma://guide/system-prompt",
                filename="agent_system_prompt.md",
                source="packages/s0ma-dsl/docs/agent_system_prompt.md",
            ),
            GuideDoc(
                key="self-prompting",
                uri="s0ma://guide/self-prompting",
                filename="self_prompting.md",
                source="packages/s0ma-dsl/docs/self_prompting.md",
            ),
            GuideDoc(
                key="quick-reference",
                uri="s0ma://guide/quick-reference",
                filename="quick-reference-readable.md",
                source="docs/reference/quick-reference-readable.md",
            ),
            GuideDoc(
                key="quick-reference-machine",
                uri="s0ma://guide/quick-reference.json",
                filename="quick-reference-machine.json",
                source="docs/_generated/quick-reference-machine.json",
            ),
            GuideDoc(
                key="patterns",
                uri="s0ma://guide/patterns",
                filename="dsl_patterns_guide.md",
                source="packages/s0ma-dsl/docs/references/dsl_patterns_guide.md",
            ),
            GuideDoc(
                key="spec",
                uri="s0ma://spec/current",
                filename="s0ma-dsl-spec-v0.17.0.md",
                source="packages/s0ma-dsl/docs/s0ma-dsl-spec-v0.17.0.md",
            ),
            GuideDoc(
                key="errors",
                uri="s0ma://guide/errors",
                filename="common_errors.md",
                source="packages/s0ma-dsl/docs/_generated/common_errors.md",
            ),
            GuideDoc(
                key="changelog",
                uri="s0ma://meta/changelog",
                filename="CHANGELOG.md",
                source="CHANGELOG.md",
            ),
        )
    }

nerve load_doc :: PRESENTATION
    kind: ADAPTER
    visibility: PUBLIC
    intent: "Resolves the packaged agent-guide documents from s0ma_mcp/_docs package data via importlib.resources so they load from an installed wheel"
    expects: "key is one of the GUIDE_DOCS loader keys"
    guarantees: "Returns the packaged document's full UTF-8 text"
    forbids: none
    evaluates_at: FUNCTION_BOUNDARY
    depends_on:
        GUIDE_DOCS: {relation: READS, carries: "packaged-document registry", coupling: TIGHT}
    provides: none
    returns: none
    raises: none
    interface: none
    latency_ms: none
    internal: none
    expected_exceptions: none
    consumes_via_dict: none
    declares_attributes: none
    covered_by: none
    ---
    def load_doc(key: str) -> str:
        """Return the full text of the packaged document ``key``.

        Args:
            key: One of ``"survival-card"``, ``"system-prompt"``,
                ``"self-prompting"``, ``"quick-reference"``,
                ``"quick-reference-machine"``, ``"patterns"``, ``"spec"``,
                ``"errors"``, ``"changelog"`` (see ``GUIDE_DOCS``).

        Returns:
            The document's UTF-8 text.

        Raises:
            KeyError: If ``key`` is not a known guide document. Start with
                ``"getting-started"`` for the canonical cold journey.
            FileNotFoundError: If the packaged file is missing from the
                installed distribution (a packaging bug — the wheel smoke
                test in the consolidation plan exists to catch this).
        """
        doc = GUIDE_DOCS[key]
        path = resources.files("s0ma_mcp").joinpath("_docs", doc.filename)
        return path.read_text(encoding="utf-8")


module studi0_narration
    layer: APPLICATION
    version: 0.19.1
    intent: "The narration side channel, both halves of it. Outbound: the presence marker studi0 writes into the project it is watching, which is how the authoring MCP server knows to ask an agent for narration at all and, when there is no marker, knows not to, because with no viewer there is no need for narration and no wish for it. Inbound: the append-only session log that agent writes, tailed at the watch's own cadence. Everything read here is the agent's account of its own work — self-reported, unverified, and true only in the sense that it was really written — so it is kept apart from the canonical graph at every level: its own file, its own module, its own counters, and its own block in the served document, which no renderer can mistake for build truth. Nothing is repaired and nothing is completed: a line that does not parse, or does not carry the narration schema, is counted and dropped, never guessed at."
    exports: [NARRATION_TYPE, NARRATION_PHASES, NARRATION_WINDOW, PRESENCE_PATH_PARTS, SESSION_LOG_PATH_PARTS, NarrationLog, presence_path, session_log_path, write_presence, clear_presence, read_narrations, narration_snapshot]

    requires: [json, os, threading, dataclasses.dataclass, dataclasses.field, pathlib.Path, typing.Any]
    uses: none
    soft_requires: none
    runtime_only_requires: none
    deferred_requires: none
    exports_helpers: none

cell NARRATION_TYPE :: APPLICATION
    kind: CONSTANT
    visibility: PUBLIC
    intent: "The one record type studi0 will render as narration. The session log is an open file any tool could append to; naming the type it accepts is what keeps a line written for some other purpose out of the pane."
    schema: "str constant. Value: work.narrated."
    invariants: none
    covered_by: ["tests/test_narration.py — a line of another type is counted invalid"]
    ---
    NARRATION_TYPE: str = "work.narrated"

cell NARRATION_PHASES :: APPLICATION
    kind: CONSTANT
    visibility: PUBLIC
    intent: "The four phases a movement can be in — the arc the narration schema froze. A phase outside this set is not a phase studi0 knows how to show, so the line carrying it is invalid rather than rendered with an unknown chip."
    schema: "tuple[str, ...] constant. Value: ('orient', 'author', 'verify', 'move_on')."
    invariants: none
    covered_by: ["tests/test_narration.py — every legal phase is accepted, an unlisted one is not"]
    ---
    NARRATION_PHASES: tuple[str, ...] = ("orient", "author", "verify", "move_on")

cell NARRATION_WINDOW :: APPLICATION
    kind: CONSTANT
    visibility: PUBLIC
    intent: "How many of the most recent narrations the served document carries. A session log grows for as long as an agent works, and the page shows a scrolling account of recent movements rather than a transcript — so the narration block is bounded here, once, instead of growing without limit inside a document the page refetches. The count of everything ever narrated is reported separately, so a bounded list never reads as a complete one."
    schema: "int constant. Value: 50 — comfortably more than a page shows at once, small enough that the state document stays the cheap poll it is."
    invariants: "The served list never exceeds this many entries."
    covered_by: ["tests/test_narration.py — the narration block is bounded and says how much it left out"]
    ---
    NARRATION_WINDOW: int = 50

cell PRESENCE_PATH_PARTS :: APPLICATION
    kind: CONSTANT
    visibility: PUBLIC
    intent: "Where studi0 says it is watching, relative to the project root: .s0ma/ is the established gitignored local-state home, studi0/ scopes it to the viewer, active.json is the marker itself. The authoring MCP server reads this exact path to decide whether to ask for narration, so the two sides name it from one place — here on the writing side, and as a literal in the rule the server renders."
    schema: "tuple[str, ...] constant of path segments joined against the project root. Value: ('.s0ma', 'studi0', 'active.json')."
    invariants: none
    covered_by: ["tests/test_narration.py — the marker lands at the documented path"]
    ---
    PRESENCE_PATH_PARTS: tuple[str, ...] = (".s0ma", "studi0", "active.json")

cell SESSION_LOG_PATH_PARTS :: APPLICATION
    kind: CONSTANT
    visibility: PUBLIC
    intent: "Where the agent appends its narration, relative to the project root — the sibling of the presence marker, and the path the survival rule spells out verbatim to the agent that writes it."
    schema: "tuple[str, ...] constant of path segments joined against the project root. Value: ('.s0ma', 'studi0', 'session.jsonl')."
    invariants: none
    covered_by: ["tests/test_narration.py — the tail reads the documented path"]
    ---
    SESSION_LOG_PATH_PARTS: tuple[str, ...] = (".s0ma", "studi0", "session.jsonl")

cell NarrationLog :: APPLICATION
    kind: MODEL
    visibility: PUBLIC
    intent: "One session's reading of one narration log: how far into the file studi0 has already read, the recent narrations it accepted, and how many lines it has seen and refused. The offset is what makes the tail a tail — each tick reads only what was appended since the last one — and the two counters are what let a bounded list of entries be honest about being bounded."
    schema: "Mutable dataclass. offset: int — bytes of complete lines already consumed; entries: list[dict[str, Any]] — the accepted narrations, oldest first, never longer than NARRATION_WINDOW; total: int — every narration accepted since this session started reading, including ones aged out of entries; invalid: int — lines seen and refused; lock: threading.Lock — held across one tail so two readers cannot both consume the same bytes."
    invariants: "len(entries) <= NARRATION_WINDOW, and total >= len(entries). offset only ever moves forward, except on a truncation, which resets the whole reading."
    covered_by: ["tests/test_narration.py — appending, tearing, and truncating the log"]
    ---
    @dataclass
    class NarrationLog:
        """How far studi0 has read into one session's narration log.

        Attributes:
            offset: Bytes of COMPLETE lines already consumed. A partial
                trailing line — an append caught mid-write — leaves the
                offset where it was, so the same bytes are re-read once
                the writer finishes the line.
            entries: The accepted narrations in file order, oldest
                first, capped at ``NARRATION_WINDOW``.
            total: Every narration accepted since this reading began,
                including the ones that have aged out of ``entries``.
            invalid: Lines read and refused — unparseable bytes,
                non-JSON, or JSON that does not carry the narration
                schema. Counted so the page can say a line was dropped;
                never rendered as narration.
            lock: Serialises one tail. Held across the read and the
                bookkeeping, never across anything else.
        """

        offset: int = 0
        entries: list[dict[str, Any]] = field(default_factory=list)
        total: int = 0
        invalid: int = 0
        lock: threading.Lock = field(default_factory=threading.Lock)

nerve presence_path :: APPLICATION
    kind: FUNCTION
    visibility: PUBLIC
    intent: "Names the presence marker for one project root, so every side of the feature — the writer, the remover, and the test that looks for it — resolves the same path from the same constant."
    expects: "project_root is the root of the project being watched"
    guarantees: "Returns the marker path under project_root; touches no filesystem"
    forbids: "Never touches the filesystem: working out the marker path reads and writes nothing."
    evaluates_at: FUNCTION_BOUNDARY
    provides: none
    returns: none
    raises: none
    interface: none
    latency_ms: none
    internal: none
    expected_exceptions: none
    consumes_via_dict: none
    declares_attributes: none
    covered_by: ["tests/test_narration.py — the marker lands at the documented path"]
    depends_on:
        PRESENCE_PATH_PARTS: {relation: READS, carries: "the marker's path segments", coupling: TIGHT}
    ---
    def presence_path(project_root: Path) -> Path:
        """``<project_root>/.s0ma/studi0/active.json``."""
        return project_root.joinpath(*PRESENCE_PATH_PARTS)

nerve session_log_path :: APPLICATION
    kind: FUNCTION
    visibility: PUBLIC
    intent: "Names the narration log for one project root — the file the agent appends to and the watch tails, resolved from one constant so the reading side can never drift from the path the rule tells the writing side."
    expects: "project_root is the root of the project being watched"
    guarantees: "Returns the log path under project_root; touches no filesystem"
    forbids: "Never touches the filesystem: working out the log path reads and writes nothing."
    evaluates_at: FUNCTION_BOUNDARY
    provides: none
    returns: none
    raises: none
    interface: none
    latency_ms: none
    internal: none
    expected_exceptions: none
    consumes_via_dict: none
    declares_attributes: none
    covered_by: ["tests/test_narration.py — the tail reads the documented path"]
    depends_on:
        SESSION_LOG_PATH_PARTS: {relation: READS, carries: "the log's path segments", coupling: TIGHT}
    ---
    def session_log_path(project_root: Path) -> Path:
        """``<project_root>/.s0ma/studi0/session.jsonl``."""
        return project_root.joinpath(*SESSION_LOG_PATH_PARTS)

nerve write_presence :: APPLICATION
    kind: FUNCTION
    visibility: PUBLIC
    intent: "Says, in the project itself, that a studi0 is watching it right now — the one file studi0 ever writes into the tree it is showing. It carries the port it is serving on and the process id serving it, and nothing else: the port so a reader can find the viewer, the pid so a reader can tell a running studi0 from a marker an unclean shutdown left behind."
    expects: "project_root is the root of the project being watched; port is the port studi0 really bound"
    guarantees: "Returns the marker path with the marker written, creating .s0ma/studi0/ if needed; the bytes are deterministic apart from the two live values — sorted keys, utf-8, one LF-terminated line, no timestamp"
    forbids: "Never writes any file into the project but this one marker under .s0ma/studi0/, and never puts anything in it but the port and the process id."
    evaluates_at: FUNCTION_BOUNDARY
    provides: none
    returns: none
    raises: none
    interface: none
    latency_ms: none
    internal: none
    expected_exceptions: none
    consumes_via_dict: none
    declares_attributes: none
    covered_by: ["tests/test_narration.py — the marker names this process and the bound port"]
    depends_on:
        presence_path: {relation: CALLS, carries: "the project root to mark", coupling: TIGHT}
    ---
    def write_presence(project_root: Path, port: int) -> Path:
        """Mark ``project_root`` as watched by this process on ``port``.

        This is the single documented exception to "studi0 never writes
        to the tree it is viewing": one small file, in the gitignored
        local-state directory, that says a viewer is here. It never
        touches a source, a build artifact, or anything the project
        builds from.

        Args:
            project_root: The project being watched.
            port: The port studi0 really bound — asked of the socket,
                not of the request, so a marker never advertises a port
                nothing is listening on.

        Returns:
            The path the marker was written to.
        """
        path = presence_path(project_root)
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(
            json.dumps({"pid": os.getpid(), "port": int(port)}, sort_keys=True) + "\n",
            encoding="utf-8",
            newline="\n",
        )
        return path

nerve clear_presence :: APPLICATION
    kind: FUNCTION
    visibility: PUBLIC
    intent: "Takes the presence marker back down on the way out, so the next agent to ask is told the truth. It removes only a marker naming THIS process: two studi0s can watch one project, and the first to exit must not withdraw the second one's claim. A marker it cannot read is not one it can claim, so it is left alone — the pid check on the reading side is what makes a leftover harmless anyway."
    expects: "project_root is the root of the project this process was watching"
    guarantees: "Returns True only when this process's own marker was removed; never raises, and is safe to call more than once and on a project that was never marked"
    forbids: "Never removes a presence marker naming another process, nor one it cannot read."
    evaluates_at: FUNCTION_BOUNDARY
    expected_exceptions: [OSError]
    provides: none
    returns: none
    raises: none
    interface: none
    latency_ms: none
    internal: none
    consumes_via_dict: none
    declares_attributes: none
    covered_by: ["tests/test_narration.py — a clean shutdown leaves no marker"]
    depends_on:
        presence_path: {relation: CALLS, carries: "the project root to unmark", coupling: TIGHT}
    ---
    def clear_presence(project_root: Path) -> bool:
        """Remove this process's presence marker under ``project_root``.

        Returns:
            True when a marker naming this process was removed; False
            when there was none, when it named another process, or when
            it could not be read or removed.
        """
        path = presence_path(project_root)
        try:
            record = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            return False
        if not isinstance(record, dict) or record.get("pid") != os.getpid():
            return False
        try:
            path.unlink()
        except OSError:
            return False
        return True

helper _projected_narration :: APPLICATION
    intent: "Reads one decoded log line and answers with the narration it carries, or with nothing at all. The schema check is deliberately minimal and deliberately total: the type, a movement worth showing, a phase studi0 knows, an optional why, and a list of subject ids. Anything else — a missing field, a wrong shape, an unlisted phase — is refused whole rather than patched into something renderable, because a repaired narration would be studi0's account of the work rather than the agent's."
    ---
    def _projected_narration(record: Any, ordinal: int) -> dict[str, Any] | None:
        """The narration ``record`` carries, or None if it carries none."""
        if not isinstance(record, dict) or record.get("type") != NARRATION_TYPE:
            return None
        movement = record.get("movement")
        if not isinstance(movement, str) or not movement.strip():
            return None
        phase = record.get("phase")
        if not isinstance(phase, str) or phase not in NARRATION_PHASES:
            return None
        why = record.get("why")
        if why is not None and not isinstance(why, str):
            return None
        subjects = record.get("subjects")
        if subjects is None:
            subjects = []
        if not isinstance(subjects, list):
            return None
        if any(not isinstance(subject, str) for subject in subjects):
            return None
        return {
            # The line's position in the session, which is the only
            # ordering the record has: no timestamp rides it (INV-5).
            "n": ordinal,
            "movement": movement,
            "why": why,
            "subjects": [str(subject) for subject in subjects],
            "phase": phase,
        }

helper _reset_log :: APPLICATION
    intent: "Starts a reading over from nothing, which is the only honest answer to a log that got shorter: the file was replaced or truncated, so the bytes at the old offset are not the continuation of what was already read. Splicing a new file onto an old reading would produce an account of work that never happened in that order."
    ---
    def _reset_log(log: NarrationLog) -> None:
        """Forget everything read so far; the file is a different file."""
        log.offset = 0
        log.entries.clear()
        log.total = 0
        log.invalid = 0

helper _consume :: APPLICATION
    intent: "Turns the complete lines of one tail into accepted narrations and refusals, in file order, keeping only the most recent window of them. Each line is decoded on its own, so undecodable bytes cost exactly the line they are in."
    ---
    def _consume(log: NarrationLog, complete: bytes) -> bool:
        """Fold ``complete`` into ``log``; True when anything changed."""
        changed = False
        for raw in complete.split(b"\n"):
            if not raw.strip():
                continue
            try:
                record = json.loads(raw.decode("utf-8"))
            except (UnicodeDecodeError, ValueError):
                log.invalid += 1
                changed = True
                continue
            narration = _projected_narration(record, log.total + 1)
            if narration is None:
                log.invalid += 1
                changed = True
                continue
            log.total += 1
            log.entries.append(narration)
            if len(log.entries) > NARRATION_WINDOW:
                del log.entries[: len(log.entries) - NARRATION_WINDOW]
            changed = True
        return changed

nerve read_narrations :: APPLICATION
    kind: FUNCTION
    visibility: PUBLIC
    intent: "Reads whatever the agent has appended to the session log since the last look, and nothing else. A line still being written is not read at all — the tail stops at the last newline and comes back for the rest next tick — so a narration is never shown half-written or half-parsed. A missing log is the ordinary case, not a failure: most sessions never narrate, and studi0 has nothing to say about that."
    expects: "log is the reading to advance; project_root is the project being watched"
    guarantees: "Returns True only when the reading actually changed. Never raises, whatever the log's bytes are doing: an unreadable or vanished file leaves the reading exactly as it was. Consumes only complete lines, in file order, and the accepted entries never exceed NARRATION_WINDOW"
    forbids: "Never writes to the agent's session log, and never takes in a line the agent has not finished writing."
    evaluates_at: FUNCTION_BOUNDARY
    expected_exceptions: [OSError]
    provides: none
    returns: none
    raises: none
    interface: none
    latency_ms: none
    internal: none
    consumes_via_dict: none
    declares_attributes: none
    covered_by: ["tests/test_narration.py — appending, tearing, and truncating the log"]
    depends_on:
        session_log_path: {relation: CALLS, carries: "the project root to tail", coupling: TIGHT}
    ---
    def read_narrations(log: NarrationLog, project_root: Path) -> bool:
        """Tail the session log under ``project_root`` into ``log``.

        Byte offsets rather than line counts, because the writer is
        appending to the same file studi0 is reading: only the bytes up
        to the last newline are a complete record of anything, and the
        offset is what makes the next tick pick up exactly where this
        one stopped.

        A file that has become SHORTER than the offset is not the file
        that was being read — a new session, or a cleared log — so the
        reading starts over rather than splicing.

        Args:
            log: The reading to advance, in place.
            project_root: The project whose log to tail.

        Returns:
            True when the reading changed — a narration was accepted, a
            line was refused, or the log was replaced.
        """
        path = session_log_path(project_root)
        with log.lock:
            try:
                size = path.stat().st_size
            except OSError:
                # No log, no directory, no permission: nothing narrated.
                return False
            reset = False
            if size < log.offset:
                _reset_log(log)
                reset = True
            if size == log.offset:
                return reset
            try:
                with path.open("rb") as handle:
                    handle.seek(log.offset)
                    chunk = handle.read(size - log.offset)
            except OSError:
                return reset
            cut = chunk.rfind(b"\n")
            if cut < 0:
                # Only a torn trailing line so far — look again next tick.
                return reset
            log.offset += cut + 1
            return _consume(log, chunk[:cut]) or reset

nerve narration_snapshot :: APPLICATION
    kind: FUNCTION
    visibility: PUBLIC
    intent: "Takes one consistent reading of a narration log — the entries, everything ever accepted, everything refused — so a served document reports three numbers that were true at the same moment. Copies are handed out rather than the live list, because the reading keeps moving while a response is being written."
    expects: "log is a reading advanced by read_narrations"
    guarantees: "Returns (entries, total, invalid) taken together under the log's lock; the entries are copies in file order, oldest first, and mutating them cannot affect the log"
    forbids: none
    evaluates_at: FUNCTION_BOUNDARY
    returns: [entries, total, invalid]
    provides: none
    raises: none
    interface: none
    latency_ms: none
    internal: none
    expected_exceptions: none
    consumes_via_dict: none
    declares_attributes: none
    covered_by: ["tests/test_narration.py — the narration block is bounded and says how much it left out"]
    depends_on: none
    ---
    def narration_snapshot(
        log: NarrationLog,
    ) -> tuple[tuple[dict[str, Any], ...], int, int]:
        """The log's (entries, total, invalid) as one consistent reading."""
        with log.lock:
            return (
                tuple(dict(entry) for entry in log.entries),
                log.total,
                log.invalid,
            )

module module_name_matches_stem
    layer: DOMAIN
    version: 1.0.0
    intent: "Regression fixture: declared module name equals the source file stem."
    exports: [identity]

    requires: none
    uses: none
    soft_requires: none
    runtime_only_requires: none
    deferred_requires: none
    exports_helpers: none
nerve identity :: DOMAIN
    kind: FUNCTION
    visibility: PUBLIC
    intent: "Returns its input unchanged; the body is trivial because this fixture exercises only the MODULE_NAME_STEM_MISMATCH check."
    expects: "x is any value"
    guarantees: "result == x"
    forbids: none
    evaluates_at: FUNCTION_BOUNDARY
    provides: none
    returns: none
    raises: none
    interface: none
    latency_ms: none
    depends_on: none
    internal: none
    expected_exceptions: none
    consumes_via_dict: none
    declares_attributes: none
    covered_by: none
    ---
    def identity(x):
        return x

cell Loan :: DOMAIN
    kind: MODEL
    visibility: PUBLIC
    intent: "FIXME(adopt): say in one sentence why this exists and who reads it."
    schema: "FIXME(adopt): say what this holds and what shape it has, in plain words."
    invariants: none
    covered_by: none
    ---
    @dataclass(frozen=True)
    class Loan:
        """One member's hold on one title, for a window of dates."""

        isbn: str
        card_number: str
        window: LoanWindow
        renewals: int = 0

        def is_overdue(self, today: date) -> bool:
            """True when ``today`` has passed the loan's due date."""
            return today > self.window.due

        def days_left(self, today: date) -> int:
            """Days left before the loan falls due; negative once it is late."""
            return (self.window.due - today).days

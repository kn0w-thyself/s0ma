module shared_header
    layer: PRESENTATION
    version: 1.0.0
    intent: "Shared <header> renderer used by both page composers in the two-pages-shared-subcomponent fixture."
    exports: [render_header]

    requires: none
    uses: none
    soft_requires: none
    runtime_only_requires: none
    deferred_requires: none
    exports_helpers: none
nerve render_header :: PRESENTATION
    kind: FUNCTION
    visibility: PUBLIC
    intent: "Render the page <header> landmark element."
    expects: "No arguments — header is static for this fixture."
    guarantees: "Returns a string starting with '<header'."
    forbids: none
    evaluates_at: FUNCTION_BOUNDARY
    declares_attributes: [landmark:header]
    provides: none
    returns: none
    raises: none
    interface: none
    latency_ms: none
    depends_on: none
    internal: none
    expected_exceptions: none
    consumes_via_dict: none
    covered_by: none
    ---
    def render_header() -> str:
        return "<header>Site title</header>"

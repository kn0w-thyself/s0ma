    ---
    def return_title(register: LoanRegister, isbn: str, card_number: str) -> dict[str, Any]:
        """Take one copy back from one member."""
        register.give_back(isbn, card_number)
        return {"isbn": isbn, "card_number": card_number, "returned": True}


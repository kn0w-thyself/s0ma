    ---
    def add_item(stock: dict[str, int], name: str, quantity: int) -> dict[str, int]:
        """Return a copy of ``stock`` holding ``quantity`` more of ``name``."""
        updated = dict(stock)
        updated[name] = updated.get(name, 0) + quantity
        return updated

nerve remove_item :: DOMAIN
    kind: FUNCTION
    visibility: PUBLIC
    intent: "FIXME(adopt): say in one sentence what this function is for and who calls it."
    expects: "FIXME(adopt): say what has to be true before this is called: what each argument must hold, and anything that must already have happened."
    guarantees: "FIXME(adopt): say what the caller gets back when this works, and name anything it refuses to do or raises an error about."
    forbids: "FIXME(adopt): say what this must never do, however it is called; write none if there is nothing to rule out."
    evaluates_at: FUNCTION_BOUNDARY
    provides: none
    returns: none
    raises: none
    interface: none
    latency_ms: none
    depends_on: none
    internal: none
    expected_exceptions: none
    consumes_via_dict: none
    declares_attributes: none
    covered_by: none
    ---
    def remove_item(stock: dict[str, int], name: str, quantity: int) -> dict[str, int]:
        """Return a copy of ``stock`` holding ``quantity`` fewer of ``name``.

        An item that falls to zero is dropped rather than kept at a negative.
        """
        updated = dict(stock)
        remaining = updated.get(name, 0) - quantity
        if remaining <= 0:
            updated.pop(name, None)
        else:
            updated[name] = remaining
        return updated

nerve low_stock :: DOMAIN
    kind: FUNCTION
    visibility: PUBLIC
    intent: "FIXME(adopt): say in one sentence what this function is for and who calls it."
    expects: "FIXME(adopt): say what has to be true before this is called: what each argument must hold, and anything that must already have happened."
    guarantees: "FIXME(adopt): say what the caller gets back when this works, and name anything it refuses to do or raises an error about."

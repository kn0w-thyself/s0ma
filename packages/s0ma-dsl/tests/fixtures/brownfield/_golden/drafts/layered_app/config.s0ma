    invariants: none
    covered_by: none
    ---
    # The data directory is the one setting that really does change between one
    # deployment and the next, so it is the one setting read from the environment.
    DATA_DIR = os.environ.get("BOOKSHELF_DATA_DIR", "var/bookshelf")

nerve loan_length_days :: DOMAIN
    kind: FUNCTION
    visibility: PUBLIC
    intent: "FIXME(adopt): say in one sentence what this function is for and who calls it."
    expects: "FIXME(adopt): say what has to be true before this is called: what each argument must hold, and anything that must already have happened."
    guarantees: "FIXME(adopt): say what the caller gets back when this works, and name anything it refuses to do or raises an error about."
    forbids: "FIXME(adopt): say what this must never do, however it is called; write none if there is nothing to rule out."
    evaluates_at: FUNCTION_BOUNDARY
    provides: none
    returns: none
    raises: none
    interface: none
    latency_ms: none
    depends_on: none
    internal: none
    expected_exceptions: none
    consumes_via_dict: none
    declares_attributes: none
    covered_by: none
    ---
    def loan_length_days(renewals: int) -> int:
        """How long a loan runs, given how often it has already been renewed.

        Renewed loans are shorter, so a title in demand comes back sooner.
        """
        if renewals <= 0:
            return DEFAULT_LOAN_DAYS
        return max(7, DEFAULT_LOAN_DAYS - 7 * renewals)

.ipynb_checkpoints/
*.ipynb

# DSL / transpiler build artifacts
*.out
*.gen
*.generated
generated/
output/
transpiled/

# s0ma DSL incremental-rebuild cache (current pre-M3 name; M3 renames the extension family)
.s0ma.cache/

# Legacy s0ma DSL cache (pre-M6a). No longer emitted; ignore lingering trees.
__s0ma_cache__/

# s0ma persistence
.s0ma/


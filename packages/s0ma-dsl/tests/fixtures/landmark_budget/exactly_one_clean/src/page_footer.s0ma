module page_footer
    layer: PRESENTATION
    version: 1.0.0
    intent: "Renders the page footer landmark for the landmark-budget clean fixture."
    exports: [render_footer]

    requires: none
    uses: none
    soft_requires: none
    runtime_only_requires: none
    deferred_requires: none
    exports_helpers: none
nerve render_footer :: PRESENTATION
    kind: FUNCTION
    visibility: PUBLIC
    intent: "Renders the page <footer> landmark element."
    expects: "No arguments — the footer is static for this fixture."
    guarantees: "Returns a string starting with '<footer'."
    forbids: none
    evaluates_at: FUNCTION_BOUNDARY
    declares_attributes: [landmark:footer]
    provides: none
    returns: none
    raises: none
    interface: none
    latency_ms: none
    depends_on: none
    internal: none
    expected_exceptions: none
    consumes_via_dict: none
    covered_by: none
    ---
    def render_footer() -> str:
        return "<footer>Copyright</footer>"

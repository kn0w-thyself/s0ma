module render_targets
    layer: DOMAIN
    version: 1.0.0
    intent: "Documentation module exercising every doc declaration format."
    exports: []

    requires: none
    uses: none
    soft_requires: none
    runtime_only_requires: none
    deferred_requires: none
    exports_helpers: none
doc-ref greetings_md
    intent: "Markdown reference for every public greetings nerve."
    format: markdown
    output: docs/greetings.md
    covers: [nerve where visibility == PUBLIC]
    sections: [intent, expects, guarantees]

doc-ref greetings_json
    intent: "JSON reference for every public greetings nerve."
    format: json
    output: docs/greetings.json
    covers: [nerve where visibility == PUBLIC]
    sections: [intent, expects, guarantees]

doc-ref greetings_html
    intent: "HTML reference for every public greetings nerve."
    format: html
    output: docs/greetings.html
    covers: [nerve where visibility == PUBLIC]
    sections: [intent, expects, guarantees]

example greet_example
    intent: "Demonstrates calling greet with a sample username."
    demonstrates: [nerve::greet]
    runs_in: standalone
    ---
    from greetings import greet

    print(greet("Ada"))

doc-guide greetings_walkthrough
    intent: "Hand-authored walkthrough that embeds the greet example."
    format: markdown
    output: docs/walkthrough.md
    covers: [nerve::greet]
    asserts: [nerve::greet.visibility == PUBLIC]
    examples: [example::greet_example]
    ---
    # Greetings walkthrough

    The {{nerve::greet}} nerve produces a greeting from a username.

    {{example::greet_example}}

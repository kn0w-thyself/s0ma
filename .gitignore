# Wrangler local state/cache. Created here because the R2 mirror runs
# `wrangler r2 object put` with this repo as cwd; it is machine-local
# tooling state, not s0ma source.
.wrangler/

# Virtual environments
.venv/
venv/
env/
ENV/
.env
.env.*

# Distribution / packaging
pip-log.txt
pip-delete-this-directory.txt
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
coverage.xml
*.cover
*.py,cover
nosetests.xml


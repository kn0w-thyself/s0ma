#   another module already carries this name.
# note: The file's `from __future__ import annotations` line is not carried into the draft: s0ma
#   writes the generated file's import block itself, and a future import has to be the first
#   statement of a file. Annotations are therefore evaluated as they are written — quote any
#   annotation that names something defined later in the file.
module config
    layer: DOMAIN
    version: 0.1.0
    intent: "FIXME(adopt): say in one sentence what this module is responsible for, and what it leaves to other modules. The Python file's docstring began: 'Settings for the lending service: no other module reads the environment.' — use that if it is true, rewrite it if it is not. Also choose this module's layer: the draft wrote DOMAIN because nothing in the file said which layer this is, and the four layers are DOMAIN, APPLICATION, INFRASTRUCTURE or PRESENTATION. A module sits at exactly one layer and every declaration in it shares that layer. The rule that settles it: a module may only use modules at its own layer or below — DOMAIN may use DOMAIN and FRAMEWORK only, APPLICATION may also use DOMAIN, and PRESENTATION and INFRASTRUCTURE may use DOMAIN and APPLICATION — so the answer is the layer that lets this module import what it already imports."
    exports:
      - DEFAULT_LOAN_DAYS
      - MAX_LOANS_PER_MEMBER
      - RENEWAL_LIMIT
      - LIBRARY_NAME
      - DATA_DIR
      - loan_length_days

    requires: [os]
    uses: none
    soft_requires: none
    runtime_only_requires: none
    deferred_requires: none
    exports_helpers: none

cell DEFAULT_LOAN_DAYS :: DOMAIN
    kind: CONSTANT
    visibility: PUBLIC
    intent: "FIXME(adopt): say in one sentence why this exists and who reads it."
    schema: "FIXME(adopt): say what this holds and what shape it has, in plain words."

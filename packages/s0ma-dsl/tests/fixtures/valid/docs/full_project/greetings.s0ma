module greetings
    layer: DOMAIN
    version: 1.0.0
    intent: "Module hosting the greet nerve referenced by doc fixtures."
    exports: [greet]

    requires: none
    uses: none
    soft_requires: none
    runtime_only_requires: none
    deferred_requires: none
    exports_helpers: none
nerve greet :: DOMAIN
    kind: FUNCTION
    visibility: PUBLIC
    intent: "Returns a greeting for the given username."
    expects: "username is a non-empty string"
    guarantees: "returns a non-empty greeting string"
    forbids: none
    evaluates_at: FUNCTION_BOUNDARY
    provides: none
    returns: none
    raises: none
    interface: none
    latency_ms: none
    depends_on: none
    internal: none
    expected_exceptions: none
    consumes_via_dict: none
    declares_attributes: none
    covered_by: none
    ---
    def greet(username):
        return f"Hello, {username}!"

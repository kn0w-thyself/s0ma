    ---
    def build_parser() -> argparse.ArgumentParser:
        """The argument parser this script is driven by."""
        parser = argparse.ArgumentParser(description="Corner-shop stock keeping.")
        parser.add_argument(
            "--add", nargs=2, metavar=("NAME", "QUANTITY"), action="append",
            default=[], help="add QUANTITY units of NAME",
        )
        parser.add_argument(
            "--remove", nargs=2, metavar=("NAME", "QUANTITY"), action="append",
            default=[], help="remove QUANTITY units of NAME",
        )
        return parser

nerve apply_changes :: DOMAIN
    kind: FUNCTION
    visibility: PUBLIC
    intent: "FIXME(adopt): say in one sentence what this function is for and who calls it."
    expects: "FIXME(adopt): say what has to be true before this is called: what each argument must hold, and anything that must already have happened."
    guarantees: "FIXME(adopt): say what the caller gets back when this works, and name anything it refuses to do or raises an error about."
    forbids: "FIXME(adopt): say what this must never do, however it is called; write none if there is nothing to rule out."
    evaluates_at: FUNCTION_BOUNDARY
    provides: none
    returns: none
    raises: none
    interface: none
    latency_ms: none
    depends_on: none
    internal: none
    expected_exceptions: none
    consumes_via_dict: none
    declares_attributes: none
    covered_by: none
    ---
    def apply_changes(
        stock: dict[str, int],
        added: list[list[str]],
        removed: list[list[str]],
    ) -> dict[str, int]:
        """Apply every addition and then every removal, in the order given."""
        for name, quantity in added:
            stock = inventory.add_item(stock, name, int(quantity))
        for name, quantity in removed:
            stock = inventory.remove_item(stock, name, int(quantity))
        return stock

nerve main :: DOMAIN
    kind: FUNCTION
    visibility: PUBLIC
    intent: "FIXME(adopt): say in one sentence what this function is for and who calls it."
    expects: "FIXME(adopt): say what has to be true before this is called: what each argument must hold, and anything that must already have happened."
    guarantees: "FIXME(adopt): say what the caller gets back when this works, and name anything it refuses to do or raises an error about."
    forbids: "FIXME(adopt): say what this must never do, however it is called; write none if there is nothing to rule out."
    evaluates_at: FUNCTION_BOUNDARY
    provides: none
    returns: none
    raises: none
    interface: none
    latency_ms: none
    depends_on: none
    internal: none
    expected_exceptions: none
    consumes_via_dict: none
    declares_attributes: none
    covered_by: none
    ---
    def main(argv: list[str] | None = None) -> int:
        """Print a stock report once the requested changes have been applied."""
        args = build_parser().parse_args(argv)
        stock = apply_changes(dict(DEFAULT_STOCK), args.add, args.remove)
        print(report.render(stock))
        return 0


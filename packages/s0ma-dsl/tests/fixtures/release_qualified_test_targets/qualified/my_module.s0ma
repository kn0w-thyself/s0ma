module my_module
    layer: DOMAIN
    version: 1.0.0
    intent: "Domain module exposing a single PUBLIC nerve."
    exports: [MyNerve]

    requires: none
    uses: none
    soft_requires: none
    runtime_only_requires: none
    deferred_requires: none
    exports_helpers: none
nerve MyNerve :: DOMAIN
    kind: FUNCTION
    visibility: PUBLIC
    intent: "Returns a constant integer for tests to assert against."
    expects: "no inputs"
    guarantees: "Returns the integer 42."
    forbids: none
    evaluates_at: FUNCTION_BOUNDARY
    provides: none
    returns: none
    raises: none
    interface: none
    latency_ms: none
    depends_on: none
    internal: none
    expected_exceptions: none
    consumes_via_dict: none
    declares_attributes: none
    covered_by: none
    ---
    def MyNerve() -> int:
        return 42

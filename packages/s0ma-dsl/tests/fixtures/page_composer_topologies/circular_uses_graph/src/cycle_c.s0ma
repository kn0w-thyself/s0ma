module cycle_c
    layer: PRESENTATION
    version: 1.0.0
    intent: "Cycle node C — uses: A (closing the cycle), declares landmark:footer, no page-composer marker."
    uses: [cycle_a.touch_a]
    exports: [touch_c]

    requires: none
    soft_requires: none
    runtime_only_requires: none
    deferred_requires: none
    exports_helpers: none
nerve touch_c :: PRESENTATION
    kind: FUNCTION
    visibility: PUBLIC
    intent: "Cycle node C's nerve — closes the A->B->C->A cycle."
    expects: "No arguments."
    guarantees: "Returns a string."
    forbids: none
    evaluates_at: FUNCTION_BOUNDARY
    declares_attributes: [landmark:footer]
    provides: none
    returns: none
    raises: none
    interface: none
    latency_ms: none
    depends_on: none
    internal: none
    expected_exceptions: none
    consumes_via_dict: none
    covered_by: none
    ---
    def touch_c() -> str:
        return "c:end"

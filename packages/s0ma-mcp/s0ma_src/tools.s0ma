module tools
    layer: PRESENTATION
    version: 0.7.0
    intent: "Tool implementations for the s0ma authoring MCP server: every tool wraps the s0ma DSL toolchain through its own command surface (the CLI invoked in-process with captured stdout/stderr and --format json, so agents receive the DSL's structured diagnostics byte-for-byte — FR-MCP-2, NFR-5) or composes the dsl's Python APIs directly; the dsl/core machinery imports are deferred to call time so the server starts even in a degraded toolchain environment and each tool call surfaces the import failure as a structured result instead of an import-time crash; every tool returns a JSON-compatible dict with an ok bool key, never raises across the MCP boundary, takes an explicit project root, and refuses writes outside the project tree (NFR-6); CLI exit codes forward as exit_code (0 success, 1 validation errors, 2 usage error, 3 internal error); the feedback pair composes the s0ma_dsl.feedback engine instead of the CLI, deferred like every other dsl import (its typed envelope is deliberately absent from every helper signature — a signature is a module-scope position, and one eager annotation would have pulled the engine to module top and cost the whole module its start-degraded property); it receives its MCP interaction facts — the calling client's identity, and the user's own approval decision — through mcp_-prefixed parameters the bootstrap's binding layer supplies and hides from the served schema, so a coding agent can never fabricate the approval a user alone can give."
    requires: [contextlib, ctypes, functools, inspect, io, json, os, sys, tomllib, collections.abc.Callable, pathlib.Path, typing.Any, typing.Literal, typing.TypeVar, typing:cast, s0ma_mcp:live_tool_map, s0ma_mcp:self_model_document, s0ma_mcp:self_model_text, s0ma_mcp:tool_journey_map]
    deferred_requires: [s0ma.examples:ExampleRunner, s0ma.registry:ComponentRegistry, s0ma_dsl.adoption:AdoptedRecordError, s0ma_dsl.adoption:load_adopted_files, s0ma_dsl.cache:extract_module_name, s0ma_dsl.cli.main:S0maCLI, s0ma_dsl.cli.main:_discover_s0ma_files, s0ma_dsl.cli.main:_snake_case, s0ma_dsl.cli.new_project:_tool_s0ma_table, s0ma_dsl.cli.docs_commands:_parse_and_validate_project, s0ma_dsl.codegen.build_manifest:BuildManifest, s0ma_dsl.codegen.build_manifest:MANIFEST_FILENAME, s0ma_dsl.codegen.build_manifest:ManifestSchemaError, s0ma_dsl.codegen.build_manifest:compute_file_hash, s0ma_dsl.codegen.build_manifest:load_manifest, s0ma_dsl.codegen.doc_emitter:compute_doc_hashes, s0ma_dsl.codegen.doc_emitter.registrations:build_example_registration, s0ma_dsl.config:StrictnessMode, s0ma_dsl.derived_surface:DerivedSurfaceError, s0ma_dsl.derived_surface:derive_python_surface, s0ma_dsl.docs_model.render_agent:AGENT_BYTE_BUDGET, s0ma_dsl.docs_model.render_agent:check_budget, s0ma_dsl.docs_model.render_agent:render_agent, s0ma_dsl.docs_model.resolve:nearest, s0ma_dsl.docs_model.resolve:resolve, s0ma_mcp:resources, s0ma_dsl.errors:S0maProjectNotFound, s0ma_dsl.feedback:REDACTION_PROFILE, s0ma_dsl.feedback:ClientInfo, s0ma_dsl.feedback:FeedbackEnvelope, s0ma_dsl.feedback:FeedbackPrivacy, s0ma_dsl.feedback:SurfaceInfo, s0ma_dsl.feedback:append_receipt, s0ma_dsl.feedback:build_context, s0ma_dsl.feedback:build_envelope, s0ma_dsl.feedback:delete_draft, s0ma_dsl.feedback:installation_id, s0ma_dsl.feedback:new_idempotency_key, s0ma_dsl.feedback:read_installation_id, s0ma_dsl.feedback:read_token, s0ma_dsl.feedback:redact_envelope, s0ma_dsl.feedback:save_draft, s0ma_dsl.feedback:submit, s0ma_dsl.feedback:validate_envelope, s0ma_dsl.parser:parse_s0ma, s0ma_dsl.project:S0maProject]
    exports: [check_tool, verify_host_tool, inspect_module_tool, describe_server_tool, learn_s0ma_tool, transpile_tool, build_project_tool, adopt_file_tool, scaffold_module_tool, init_project_tool, migrate_ext_tool, project_status_tool, run_example_tool, prepare_feedback_tool, submit_feedback_tool]

    uses: none
    soft_requires: none
    runtime_only_requires: none
    exports_helpers: none
cell _ToolFn :: PRESENTATION
    kind: CONSTANT
    visibility: INTERNAL
    intent: "TypeVar bound to the tool-callable shape so the _safe boundary decorator preserves each tool's exact signature under mypy --strict."
    schema: "typing.TypeVar bound to Callable[..., dict[str, Any]]."
    invariants: none
    covered_by: none
    ---
    _ToolFn = TypeVar("_ToolFn", bound=Callable[..., dict[str, Any]])


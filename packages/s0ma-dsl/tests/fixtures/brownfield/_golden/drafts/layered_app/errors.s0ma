    ---
    class RenewalRefusedError(LendingError):
        """This loan has been renewed as often as the rules allow."""

        def __init__(self, isbn: str, limit: int) -> None:
            super().__init__(f"ISBN {isbn} has already been renewed {limit} times")
            self.isbn = isbn
            self.limit = limit

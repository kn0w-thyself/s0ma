module prohibited_construct
    layer: DOMAIN
    version: 1.0.0
    intent: "Module with a prohibited eval() call in body"
    exports: [evil_func]

    requires: none
    uses: none
    soft_requires: none
    runtime_only_requires: none
    deferred_requires: none
    exports_helpers: none
nerve evil_func :: DOMAIN
    kind: FUNCTION
    visibility: PUBLIC
    intent: "Contains eval() which is a prohibited construct"
    expects: "a string expression"
    guarantees: "Returns evaluated result"
    forbids: none
    evaluates_at: FUNCTION_BOUNDARY
    provides: none
    returns: none
    raises: none
    interface: none
    latency_ms: none
    depends_on: none
    internal: none
    expected_exceptions: none
    consumes_via_dict: none
    declares_attributes: none
    covered_by: none
    ---
    def evil_func(expr: str):
        return eval(expr)

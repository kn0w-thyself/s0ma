module music_tests
    layer: DOMAIN
    version: 0.1.0
    intent: "Tests for settling on a song's mood."
    uses: [music.Track, music.settle_mood]
    exports: []

    requires: none
    soft_requires: none
    runtime_only_requires: none
    deferred_requires: none
    exports_helpers: none
test test_settle_mood_picks_one_of_four :: DOMAIN
    intent: "How fast and loud a song is, and its key, decide which of the four moods it gets."
    tests: [music.settle_mood]
    expects: none
    depends_on: none
    mocks: none
    ---
    def test_settle_mood_picks_one_of_four() -> None:
        def song(bpm: int, loudness: float, major: bool) -> Track:
            return Track(title="t", artist="a", beats_per_minute=bpm,
                         loudness=loudness, major_key=major)
        assert settle_mood(song(130, 0.9, True)).name == "lively"
        assert settle_mood(song(130, 0.9, False)).name == "tense"
        assert settle_mood(song(70, 0.2, True)).name == "calm"
        assert settle_mood(song(70, 0.2, False)).name == "low"

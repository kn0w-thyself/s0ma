    ---
    def due_soon_message(loan: Loan, days_left: int) -> tuple[str, str]:
        """The subject and body of the reminder sent before a loan falls due."""
        subject = f"{LIBRARY_NAME}: a book is due back in {days_left} days"
        body = (
            f"ISBN {loan.isbn} is due back on {loan.window.due.isoformat()}. "
            "You can renew it at the counter or on the library's website."
        )
        return subject, body

nerve remind_member :: DOMAIN
    kind: FUNCTION
    visibility: PUBLIC
    intent: "FIXME(adopt): say in one sentence what this function is for and who calls it."
    expects: "FIXME(adopt): say what has to be true before this is called: what each argument must hold, and anything that must already have happened."
    guarantees: "FIXME(adopt): say what the caller gets back when this works, and name anything it refuses to do or raises an error about."
    forbids: "FIXME(adopt): say what this must never do, however it is called; write none if there is nothing to rule out."
    evaluates_at: FUNCTION_BOUNDARY
    provides: none
    returns: none
    raises: none
    interface: none
    latency_ms: none
    depends_on: none
    internal: none
    expected_exceptions: none
    consumes_via_dict: none
    declares_attributes: none
    covered_by: none
    ---
    async def remind_member(
        notifier: Notifier, member: Member, loans: list[Loan], today: date
    ) -> int:
        """Send one reminder per loan that is nearly due, and count what was sent.

        This is a coroutine because a real channel would wait on the network.
        The in-memory notifier finishes without waiting for anything.
        """
        sent = 0
        for loan in loans:
            days_left = loan.days_left(today)
            if 0 <= days_left <= REMINDER_WINDOW_DAYS:
                subject, body = due_soon_message(loan, days_left)
                notifier.send(member, subject, body)
                sent += 1
        return sent

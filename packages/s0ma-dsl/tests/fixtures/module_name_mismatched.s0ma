module wrong_name
    layer: DOMAIN
    version: 1.0.0
    intent: "Regression fixture: the declared module name (wrong_name) diverges on purpose from the source file stem (module_name_mismatched), so s0ma check must emit a single MODULE_NAME_STEM_MISMATCH error and the build fails fast instead of silently producing imports that resolve to the wrong file."
    exports: [identity]

    requires: none
    uses: none
    soft_requires: none
    runtime_only_requires: none
    deferred_requires: none
    exports_helpers: none
nerve identity :: DOMAIN
    kind: FUNCTION
    visibility: PUBLIC
    intent: "Trivial body: this fixture exercises only the MODULE_NAME_STEM_MISMATCH check."
    expects: "x is any value"
    guarantees: "result == x"
    forbids: none
    evaluates_at: FUNCTION_BOUNDARY
    provides: none
    returns: none
    raises: none
    interface: none
    latency_ms: none
    depends_on: none
    internal: none
    expected_exceptions: none
    consumes_via_dict: none
    declares_attributes: none
    covered_by: none
    ---
    def identity(x):
        return x
